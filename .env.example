# ===== LLM =====
# OpenAI 兼容接口 (可换 deepseek / moonshot / qwen 等)
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://api.openai.com/v1
CHAT_MODEL=gpt-4o-mini
CHAT_MODEL_MINI=gpt-4o-mini

# ===== mem0 =====
# 默认用本地 ChromaDB (纯 Python 文件存储, 零外部服务)
# 也可切换到 qdrant (需自行启动服务), 见 src/alf/config/mem0_config.py
MEM0_STORE=local
MEM0_DATA_DIR=./mem0_data
# 关闭 mem0 遥测和 PostHog 多客户端警告
MEM0_TELEMETRY=false

# 如使用 OpenAI embedding
MEM0_EMBEDDER=openai
EMBEDDING_MODEL=text-embedding-3-small

# ===== ALF =====
ALF_USER_ID=oliver
ALF_AGENT_NAME=小奥
