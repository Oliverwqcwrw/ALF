# ===== LLM =====
# OpenAI 兼容接口 (可换 deepseek / moonshot / qwen 等)
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://api.openai.com/v1
CHAT_MODEL=gpt-4o-mini
CHAT_MODEL_MINI=gpt-4o-mini

# ===== mem0 =====
# 默认用本地 sqlite + 本地向量, 无需外部依赖
# 也可切换到 Qdrant / Chroma, 见 config/mem0_config.py
MEM0_STORE=local
MEM0_DATA_DIR=./mem0_data

# 如使用 OpenAI embedding
MEM0_EMBEDDER=openai
EMBEDDING_MODEL=text-embedding-3-small

# ===== ALF =====
ALF_USER_ID=oliver
ALF_AGENT_NAME=小奥
